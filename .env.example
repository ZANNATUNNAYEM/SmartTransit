# ==============================================================================
# SmartTransit Environment Variables Template for Vercel & Local Development
# ==============================================================================

# MongoDB Connection String (Atlas URI)
# IMPORTANT: In MongoDB Atlas -> Network Access, add IP 0.0.0.0/0 so Vercel serverless can connect.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smarttransit?retryWrites=true&w=majority

# JWT Secrets for Authentication (Generate random 64+ char strings)
JWT_SECRET=your_super_secret_jwt_key_at_least_64_characters_long_for_security
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_at_least_64_characters_long

# Application Base URL (e.g. https://your-project.vercel.app or http://localhost:3000)
APP_URL=https://your-smarttransit-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-smarttransit-app.vercel.app

# Cloudinary (Image Uploads for profile pictures)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenWeather API (Weather widget)
OPENWEATHER_API_KEY=your_openweather_api_key

# Nodemailer / Gmail SMTP (Email verification)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_16_digit_app_password
EMAIL_FROM=SmartTransit <your_email@gmail.com>

# OneSignal Push Notifications (Optional)
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

